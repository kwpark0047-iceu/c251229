# Supabase 설정 (필수)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버사이드 전용 (백업/복원, cron 등 고권한 작업에 사용 - 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LocalData API 키 (서버사이드 전용)
# https://www.localdata.go.kr 에서 발급받은 API 키
LOCALDATA_API_KEY=your-localdata-api-key

# Gemini API 키 (서버사이드 전용 - AI 상권분석)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI API 키 (서버사이드 전용 - AI 상권분석 폴백)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 역사별 정보 API (서울교통공사)
# 서비스ID: convenientInfo, 오퍼레이션ID: stationInfo
STATION_INFO_API_KEY=your-station-info-api-key

# 경기도 공공데이터 API 키 (서버사이드 전용)
GG_DATA_API_KEY=your-gg-data-api-key
GG_CLINIC_API_KEY=your-gg-clinic-api-key
GG_HOSPITAL_API_KEY=your-gg-hospital-api-key
GG_REST_API_KEY=your-gg-rest-api-key
GG_UNIV_API_KEY=your-gg-univ-api-key
GG_JNCL_UNIV_API_KEY=your-gg-jncl-univ-api-key

# 서울 열린데이터광장 API 키 (서버사이드 전용)
SEOUL_DATA_API_KEY=your-seoul-data-api-key
SEOUL_DATA_CLINIC_API_KEY=your-seoul-data-clinic-api-key
SEOUL_DATA_HOSPITAL_API_KEY=your-seoul-data-hospital-api-key
SEOUL_DATA_FITNESS_API_KEY=your-seoul-data-fitness-api-key
SEOUL_DATA_QUASI_MEDICAL_API_KEY=your-seoul-data-quasi-medical-api-key

# KRIC 역사 편의시설 API (서버사이드)
KRIC_API_KEY=your-kric-api-key

# 기타 외부 API (서버사이드 전용)
DATAGOKR_API_KEY=your-datagokr-api-key
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# Resend 이메일 발송 (서버사이드 전용)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_FROM_NAME=Lead Manager

# Cron/동기화 API 인증 (Bearer 토큰)
CRON_SECRET=your-cron-secret

# 공개 사이트 URL (절대경로 이메일 링크 등)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
