{
  "name": "economy-news",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:setup": "npm run db:dev:generate && npm run db:dev:push && npm run db:seed",
    "build": "next build",
    "vercel-build": "next build",
    "vercel-install": "npm install",
    "validate-env": "tsx scripts/validate-env.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:dev:generate": "node scripts/generate-sqlite-schema.mjs && prisma generate --schema=prisma/schema.sqlite.prisma",
    "db:dev:push": "node scripts/generate-sqlite-schema.mjs && prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:check:drift": "node scripts/check-schema-drift.mjs",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:studio": "prisma studio",
    "cleanup:sports": "tsx scripts/cleanup-sports-pollution.ts",
    "ram:measure": "node scripts/measure-ram.mjs",
    "ram:fit": "node scripts/fit-check.mjs",
    "ram:pipeline": "node scripts/measure-ram.mjs && node scripts/fit-check.mjs",
    "seed:ooh": "tsx scripts/seed-ooh.ts",
    "worker": "tsx worker/index.ts",
    "cron-worker": "tsx worker/cron-worker.ts",
    "dev:fetch": "tsx scripts/dev-fetch.ts",
    "dev:fetch:source": "tsx scripts/dev-fetch.ts",
    "fetch": "curl -X POST http://localhost:3000/api/cron",
    "db:resolve:baseline": "npx prisma migrate resolve --applied 0001_init"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.69.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "next": "16.2.10",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.6",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
